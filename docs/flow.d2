shape: sequence_diagram

"Coding harness": {
  icon: https://raw.githubusercontent.com/devicons/devicon/master/icons/vscode/vscode-original.svg
}
"Stdio front end": {
  icon: https://cdn.simpleicons.org/modelcontextprotocol
}
"Store process"
"Embedding model"
HelixDB: {
  icon: https://cdn.simpleicons.org/rust
}

"Coding harness" -> "Stdio front end": "launch over stdio"
"Stdio front end" -> "Store process": "connect to socket, or start it and wait"
"Store process" -> HelixDB: "take lock, open graph (first start only)"
"Stdio front end" -> "Store process": "hello with harness working directory"

"Coding harness" -> "Stdio front end": "memory_recall(query)"
"Stdio front end" -> "Store process": "forward MCP request"
"Store process" -> "Embedding model": "embed query"
"Embedding model" -> "Store process": "query vector"
"Store process" -> HelixDB: "traverse, then BM25 and vector rank"
HelixDB -> "Store process": "ranked active memories"
"Store process" -> "Coding harness": "hits, or empty when below the floor"

"Coding harness" -> "Stdio front end": "memory_remember(statement, entities)"
"Stdio front end" -> "Store process": "forward MCP request"
"Store process" -> "Store process": "take write lock"
"Store process" -> "Embedding model": "embed statement"
"Embedding model" -> "Store process": "memory vector"
"Store process" -> HelixDB: "duplicate check, then commit node and embedding"
HelixDB -> "Store process": "committed"
"Store process" -> HelixDB: "write entity edges"
HelixDB -> "Store process": "linked"
"Store process" -> "Coding harness": "created, updated, or superseded"
